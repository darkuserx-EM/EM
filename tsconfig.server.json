{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server/security.mjs",
    "server/totp.mjs",
    "server/session-policy.mjs",
    "server/sql.mjs",
    "server/audit-storage.mjs",
    "server/attachment-batches.mjs",
    "server/type-tests/**/*.mts"
  ]
}
