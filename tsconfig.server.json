{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "skipLibCheck": false,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "server/**/*.mjs",
    "server/**/*.ts",
    "server/**/*.mts"
  ],
  "exclude": [
    "server/**/*.test.mjs",
    "server/**/*.test.ts",
    "server/generated"
  ]
}
