{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "server/security.mjs",
    "server/totp.mjs",
    "server/session-policy.mjs",
    "server/sql.mjs",
    "server/audit-storage.mjs",
    "server/attachment-batches.mjs",
    "server/type-tests/**/*.mts",
    "server/database.mjs",
    "server/snapshot-cache.mjs",
    "server/equipment-images.mjs",
    "server/diagnostics.mjs"
  ]
}
