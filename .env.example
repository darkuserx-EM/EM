# Variables del servidor; completar solo en Hostinger o en un archivo .env ignorado.
NODE_ENV=production
APP_ORIGIN=https://portal.expertosenmontacargas.com
PORT=3000
# Conservar 1 hasta verificar la cadena real del alojamiento. Nunca usar true.
TRUST_PROXY=1
# Activar solo durante la comprobación de red con una sesión de administración.
ENABLE_NETWORK_DIAGNOSTICS=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Clave aleatoria de instalación, mínimo 32 caracteres. Retirarla tras crear la cuenta.
SETUP_TOKEN=
# Única variable pública: no poner contraseñas en variables VITE_*.
VITE_DATA_MODE=server

# Cierre tras inactividad real: 15 a 240 minutos; el sondeo no renueva.
SESSION_IDLE_MINUTES=60

# Opcional: clave base64 de 32 bytes, exclusiva del alojamiento; respaldar en gestor seguro.
TOTP_ENCRYPTION_KEY=

# Almacenamiento privado optativo. Mantener mysql hasta probar la conexión y el respaldo.
FILE_STORAGE=mysql
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_OWNER_EMAIL=
# GOOGLE_PICKER_API_KEY y GOOGLE_CLOUD_PROJECT_NUMBER solo se usan en el asistente local.
# Nunca usar variables VITE_* para estas credenciales.
