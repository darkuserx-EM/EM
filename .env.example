# Variables del servidor; completar solo en Hostinger o en un archivo .env ignorado.
NODE_ENV=production
APP_ORIGIN=https://portal.expertosenmontacargas.com
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Clave aleatoria de instalación, mínimo 32 caracteres. Retirarla tras crear la cuenta.
SETUP_TOKEN=
# Única variable pública: no poner contraseñas en variables VITE_*.
VITE_DATA_MODE=server
